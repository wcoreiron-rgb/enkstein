# Marcellus — Environment Variables
# Copy this file to .env and fill in your values
#
# ⚠️  SECURITY REQUIREMENTS (must change before any non-local deployment):
#   1. SECRET_KEY  — generate with: python -c "import secrets; print(secrets.token_hex(32))"
#   2. POSTGRES_PASSWORD — change from the default
#   3. REDIS_PASSWORD    — set a strong password
#   4. DEBUG=false       — never enable in production (bypasses all auth)

# ── Database ──────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://marcellus:CHANGE_ME@localhost:5432/marcellus
POSTGRES_USER=marcellus
POSTGRES_PASSWORD=CHANGE_ME        # ← must change
POSTGRES_DB=marcellus

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_URL=redis://:CHANGE_ME@localhost:6379
REDIS_PASSWORD=CHANGE_ME           # ← must change

# ── Security ──────────────────────────────────────────────────────────────────
# Generate: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=CHANGE_ME_generate_with_secrets_token_hex_32
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
ADMIN_USERNAME=admin
ADMIN_PASSWORD=CHANGE_ME

# ── Verified email sign-in ────────────────────────────────────────────────────
# An approved Email connector can supply these values instead. Email ownership
# creates a read-only viewer session; owner/admin credentials remain separate.
EMAIL_AUTH_ENABLED=true
EMAIL_AUTH_CODE_TTL_SECONDS=600
EMAIL_AUTH_MAX_ATTEMPTS=5
EMAIL_AUTH_SMTP_HOST=
EMAIL_AUTH_SMTP_PORT=587
EMAIL_AUTH_SMTP_USERNAME=
EMAIL_AUTH_SMTP_PASSWORD=
EMAIL_AUTH_FROM=

# Native subscription Brain Bridge (set automatically by desktop installers).
BRAIN_BRIDGE_URL=
BRAIN_BRIDGE_SECRET=
BRAIN_BRIDGE_TIMEOUT_SECONDS=180

# Cowork governed turn streaming. Heartbeats keep the SSE connection warm while a
# long turn runs; the deadline hard-bounds a stalled turn so the stream always
# resolves to a terminal state instead of hanging.
WORKSPACE_STREAM_HEARTBEAT_SECONDS=10
# AI endpoint rate limiting (OWASP LLM04), per authenticated identity.
AI_RATE_LIMIT_WINDOW_SECONDS=60
AI_RATE_LIMIT_MAX_REQUESTS=20
# OAuth app client ID for GitHub device-code sign-in. Microsoft connectors use
# a first-party public client and need nothing here; GitHub has no equivalent,
# so interactive sign-in stays disabled until you supply your own OAuth app.
# Credential (PAT) configuration works either way.
GITHUB_OAUTH_CLIENT_ID=
# Browser sign-in (OAuth authorization code + PKCE) for connectors. Microsoft
# works with no setup because Azure CLI publishes a loopback-registered public
# client. These vendors publish none, so register a native/public OAuth app
# once with redirect URI http://127.0.0.1:47822/connector-callback and put its
# client ID here. PKCE means no client secret is needed or stored.
# An operator can also enter the client ID per connector in the UI instead.
GITLAB_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_ID=
SLACK_OAUTH_CLIENT_ID=
ATLASSIAN_OAUTH_CLIENT_ID=
DATADOG_OAUTH_CLIENT_ID=
SNYK_OAUTH_CLIENT_ID=
PAGERDUTY_OAUTH_CLIENT_ID=
SALESFORCE_OAUTH_CLIENT_ID=
WORKSPACE_STREAM_DEADLINE_SECONDS=180
WORKSPACE_STREAM_BROWSER_DEADLINE_SECONDS=210

# ── App ───────────────────────────────────────────────────────────────────────
APP_NAME=Enkstein
APP_VERSION=0.5.12
DEBUG=false                        # ← NEVER set true in production
ALLOWED_ORIGINS=http://localhost:3000

# ── Ports ─────────────────────────────────────────────────────────────────────
# The desktop launchers rewrite these at startup, stepping past a port that is
# already in use rather than failing to bind.
FRONTEND_PORT=3000
BACKEND_PORT=8000

# Production data policy.
# Capability Nodes show labelled demonstration findings when no connector is
# configured, so a fresh install is explorable. Set this to true for a real
# deployment: nodes then return nothing instead, so everything on screen came
# from an authenticated connector and cannot be mistaken for your own estate.
REQUIRE_LIVE_DATA=false

# Optional: AI providers (for AI Security / Copilot workflow generation)
# Add these via Connectors UI — they are encrypted and stored locally.
# You can also set them here as environment variable overrides.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
NVIDIA_API_KEY=           # Free — get at https://build.nvidia.com/models
GEMINI_API_KEY=           # Prefer an approved Gemini connector in the UI
# Optional preferred local model. When absent or unavailable, Marcellus selects
# a compatible installed Ollama model and records the actual model used.
MARCELLUS_OLLAMA_MODEL=

# ── AGT Feature Flags (optional rollout controls) ────────────────────────────
AGT_VERSION_MODE=v1_compat
AGT_ENABLE_AGENT_MESH=false
AGT_ENABLE_E2E_MESSAGING=false
AGT_ENABLE_MCP_GATEWAY=false
AGT_ENABLE_SHADOW_DISCOVERY=false

# ── Trust Fabric SRE Policy Layer ────────────────────────────────────────────
SRE_POLICY_ENABLED=true
SRE_WINDOW_MINUTES=30
SRE_ERROR_BUDGET=0.10
SRE_CIRCUIT_BREAKER_THRESHOLD=0.50
SRE_CIRCUIT_BREAKER_OPEN_SECONDS=120
SRE_MIN_SAMPLES=5
